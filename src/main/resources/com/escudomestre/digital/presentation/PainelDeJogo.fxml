<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.escudomestre.digital.presentation.PainelDeJogoController"
      xmlns:fx="http://javafx.com/fxml"
      alignment="TOP_LEFT"
      spacing="12"
      prefWidth="1366.0"
      prefHeight="768.0">
    <Label text="Painel de Jogo e Simulador" styleClass="titulo-painel"/>
    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <ListView fx:id="listaFichas"
                  HBox.hgrow="ALWAYS"
                  VBox.vgrow="ALWAYS"
                  minWidth="420.0"/>
        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              VBox.vgrow="ALWAYS"
              minWidth="480.0">
            <HBox spacing="8">
                <Label text="Personagem:"/>
                <TextField fx:id="campoNome" editable="false" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="8">
                <Label text="PV atual:"/>
                <TextField fx:id="campoPv" editable="false" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="8">
                <Label text="Valor do dano:"/>
                <TextField fx:id="campoValorDano" text="1" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="8">
                <Label text="Resultado da rolagem:"/>
                <TextField fx:id="campoResultadoRolagem" editable="false" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Rolar Ataque (F5)" onAction="#rolarAtaque" HBox.hgrow="ALWAYS"/>
                <Button text="Rolar Dano (F6)" onAction="#rolarDano" HBox.hgrow="ALWAYS"/>
                <Button text="Aplicar Dano (F7)" onAction="#aplicarDano" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
