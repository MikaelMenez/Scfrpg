<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox fx:controller="com.escudomestre.digital.presentation.CriacaoPersonagemController"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="16"
      prefWidth="1366.0"
      prefHeight="768.0">
    <VBox spacing="20" maxWidth="760.0" alignment="TOP_CENTER">
        <VBox spacing="2" alignment="TOP_CENTER">
            <Label text="Nova Ficha de Personagem" styleClass="titulo-pagina"/>
            <Label text="Preencha os atributos para criar a ficha (RU01)" styleClass="subtitulo"/>
        </VBox>

        <VBox spacing="12" styleClass="card">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Nome *" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoNome" styleClass="campo" promptText="ex.: Aragorn" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Raça" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoRaca" styleClass="campo" promptText="ex.: Humano" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Classe" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoClasse" styleClass="campo" promptText="ex.: Guerreiro" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Nível" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoNivel" styleClass="campo" text="1" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="PV máximo" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoPvMaximo" styleClass="campo" text="30" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="PV atual" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoPvAtual" styleClass="campo" text="30" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Classe de Armadura" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoClasseArmadura" styleClass="campo" text="10" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Modificador de ataque" styleClass="rotulo" prefWidth="150"/>
                <TextField fx:id="campoModificadorAtaque" styleClass="campo" text="0" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <Label fx:id="labelErro"
               styleClass="erro"
               wrapText="true"
               managed="false"
               visible="false"/>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Cancelar" styleClass="botao botao-secundario" onAction="#cancelar"/>
            <Button text="Salvar Ficha" styleClass="botao botao-sucesso" onAction="#salvar"/>
        </HBox>
    </VBox>
</HBox>
